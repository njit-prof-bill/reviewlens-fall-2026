# API Configuration
APP_NAME=reviewlens-api
APP_SLUG=reviewlens
API_NAME=reviewlens-api
APP_VERSION=0.1.0
DATABASE_NAME=reviewlens

# Clerk token verification (backend)
CLERK_JWKS_URL=
# Optional strict verification knobs
CLERK_ISSUER=
CLERK_AUDIENCE=

# Review collection provider (server-side only; never expose to the browser).
# Reviews are collected from the AnalysisTarget's Google Maps URL through this
# provider. Without a key, URL ingestion fails with provider_not_configured and
# only the file-import recovery path works.
REVIEW_PROVIDER=serpapi
REVIEW_PROVIDER_API_KEY=
REVIEW_PROVIDER_TIMEOUT_SECONDS=30
REVIEW_FETCH_MAX=100

# Upper bound for the file-import recovery path (bytes).
MAX_IMPORT_FILE_BYTES=2097152

# CORS Origins (comma-separated)
# Wildcards are supported, e.g. https://*.your-project.pages.dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174,http://localhost:3000,http://127.0.0.1:3000
# Optional extra regex (advanced): append to the computed allow-origin regex
# CORS_ORIGIN_REGEX=

# Optional: explicit database URL override for migrations/runtime
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/reviewlens
